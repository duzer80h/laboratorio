<%- include("../partials/header") %>
<section>
  <div class="container">
    <h2 class="h2 text-uppercase mb-5 mt-5 text-dark">
      <%= servico.nome %>
    </h2>
  </div>
</section>
<section class="mb-5">
  <div class="container d-lg-flex column-gap-3">
    <div class="w-lg-50 mb-3 mb-lg-0">
      <img class="img-fluid"
        src="/assets/img/<%= servico.imagem %>"
        alt="<%= servico.nome %>"
      />
    </div>
    <div class="w-lg-50">
      <p class="mb-3">
        <%= servico.descricao %>
      </p>
      <div class="d-flex column-gap-3 align-items-center mb-3">
        <i class="fa-regular fa-clock text-warning fs-3"></i>
        <div>
          <div>
            Tempo de execução
          </div>
          <div class="fw-bold mt-1">
            <%= servico.tempoExecucao.slice(0,5) %> horas
          </div>
        </div>
      </div>
      <div class="d-flex column-gap-3 align-items-center mb-3">
        <i class="fa-regular fa-calendar text-warning fs-3"></i>
        <div>
          <div>
            Validade
          </div>
          <div class="fw-bold mt-1">
            <%= servico.validade %>
          </div>
        </div>
      </div>
      <div class="d-flex column-gap-3 align-items-center">
        <i class="fa-regular fa-money-bill-1 text-warning fs-3"></i>
        <div>
          <div>
            Preço
          </div>
          <div class="fw-bold mt-1">
            R$ <%= servico.preco.replace('.', ',') %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include("../partials/footer") %>