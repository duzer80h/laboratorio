<%- include("../partials/header") %>
  <section class="py-100 servicos">
    <h2 class="text-center h2 text-uppercase mb-5 text-dark">Serviços</h2>
    <div class="container d-lg-flex column-gap-3 justify-content-between">
      <% servicos.forEach((servico) => { %>
      <div class= "mt-md-5">
              <div
            class="capa shadow"
            style="
              background-image: url('/assets/img/<%= servico.imagem %>');
            "
          ></div>
          <h3 class="text-warning mt-3 fs-3 fw-normal"> <%= servico.nome %> </h3>
          <p class="mt-1 mb-1"><%= servico.descricao %></p>
          <a
            href="/servicos/<%= servico.slug %>"
            class="text-dark text-decoration-none d-flex align-items-center column-gap-1"
          >
            <span class="btn btn-success btn-sm">+</span>
            <span>Saiba mais</span>
          </a>
        </div> 
      <% }) %>
    </div>
  </section>
  <script src="/assets/js/servicos.js"></script>
  <%- include("../partials/footer") %>