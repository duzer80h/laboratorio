<%- include("../partials/header") %>
<section>
  <div class="container">
    <h2 class="h2 text-uppercase mb-5 mt-5 text-dark">
      <%= artigo.titulo %>
    </h2>
  </div>
</section>
<section class="mb-5">
  <div class="container d-lg-flex column-gap-3">
    <div class="w-lg-50 mb-3 mb-lg-0">
      <img class="img-fluid"
        src="/assets/img/<%= artigo.imagem %>"
        alt="<%= artigo.titulo %>"
      />
    </div>
    <div class="w-lg-50">
      <p class="mb-3" style="white-space: pre-line;">
        <%= artigo.conteudo %>
      </p>
      <div class="d-flex column-gap-3 align-items-center mb-3">
        <i class="fa-regular fa-calendar text-warning fs-3"></i>
        <div>
          <div>
            Data
          </div>
          <div class="fw-bold mt-1">
            <%= new Date(artigo.createdAt).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include("../partials/footer") %>